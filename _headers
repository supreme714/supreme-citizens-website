/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net https://www.instagram.com; style-src 'self' 'unsafe-inline' https://www.instagram.com; script-src 'self' https://www.instagram.com; font-src 'self'; connect-src 'self' https://www.instagram.com; frame-src https://www.facebook.com https://www.instagram.com; frame-ancestors 'self';
